+/// PATCH 2 (no row): the cell at `point`, or a default cell for a line outside the grid.
+fn cell_at<T>(term: &Term<T>, point: Point) -> crate::term::cell::Cell {
+    if point.line < term.topmost_line() || point.line > term.bottommost_line() {
+        crate::term::cell::Cell::default()
+    } else {
+        term.grid()[point].clone()
+    }
